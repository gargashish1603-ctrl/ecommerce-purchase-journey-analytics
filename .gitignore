# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
env/
.venv/
ENV/

# Large Data files (keep raw & processed data directories tracked via .gitkeep, but ignore actual large CSVs/Parquet if needed)
# For this project, raw and generated datasets can be managed or ignored as size dictates
data/raw/*.csv
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
